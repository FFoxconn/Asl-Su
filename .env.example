# Copy to .env on the server and fill in real values. Never commit .env.
MSSQL_SA_PASSWORD=ChangeThisStrongPassword123!
JWT_SIGNING_KEY=ChangeThisToARandomLongSecretString

# Seed the first admin account on first boot (leave both empty to skip seeding).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Trendyol Go — from partner.tgomarket.com and developers.tgoapps.com. Leave
# empty until confirmed; the app runs fine without them, Trendyol sync just
# stays disabled and reports "not configured" instead of guessing.
TRENDYOL_SUPPLIER_ID=
TRENDYOL_API_KEY=
TRENDYOL_API_SECRET=
TRENDYOL_BASE_URL=
TRENDYOL_AGENT_NAME=
TRENDYOL_EXECUTOR_USER=

# Google Maps JavaScript API key, used by the web panel's "Kurye Haritası"
# page. Restrict it to this server's domain in Google Cloud Console
# (Credentials -> the key -> Application restrictions -> Websites).
VITE_GOOGLE_MAPS_API_KEY=
