# Base URL of the AslSu backend API. Never put Trendyol Go credentials here —
# the web app never talks to Trendyol directly.
VITE_API_BASE_URL=https://localhost:5001

# Used by the "Kurye Haritası" (courier map) page. Restrict it to your domain
# in Google Cloud Console once you have one.
VITE_GOOGLE_MAPS_API_KEY=
